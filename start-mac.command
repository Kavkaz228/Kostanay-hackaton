#!/bin/sh
# Двойной щелчок в Finder запускает Allur twin 2.0 и открывает его в браузере.
# Если macOS не открывает файл: правый щелчок → «Открыть» → «Открыть».
cd "$(dirname "$0")"
sh ./start.sh
status=$?
echo
if [ "$status" -eq 0 ]; then echo 'Окно Терминала можно закрыть: приложение продолжит работать.'; else echo 'Запуск не удался — подробности выше.'; fi
echo 'Остановить приложение: дважды щёлкните stop-mac.command.'
